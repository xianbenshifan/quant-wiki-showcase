{
  "$comment": "示例配置。复制为 publish.config.json 后填入你自己的路径。publish.config.json 已被 .gitignore 忽略，不要把它提交进仓库。",
  "vault": "D:\\path\\to\\your\\quant-wiki-vault",
  "contentDir": "content",
  "excludeDirs": ["source-docs", "meta", ".obsidian"],
